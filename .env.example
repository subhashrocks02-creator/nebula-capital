# Environment Configuration for Nebula Capital Advisory Pvt. Ltd.

# Resend API Key for server-side email delivery (obtain from https://resend.com)
# NEVER expose this variable to browser/client-side code or prefix with VITE_
RESEND_API_KEY=re_123456789_YourResendApiKeyHere

# HR recipient email address where job applications and contact messages will be delivered
HR_EMAIL=hradmin@nebulacapital.co.in

# Verified sender email address / identity configured in your Resend account domain settings
# Example: careers@nebulacapital.co.in or website@nebulacapital.co.in
MAIL_FROM=careers@nebulacapital.co.in
